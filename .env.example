# Trading Bot Zai v1 — Environment Configuration
# Copy this file to .env and fill in your credentials
# cp .env.example .env

# ─── Quotex Credentials (REQUIRED) ────────────────────────────────────
QUOTEX_EMAIL=your_email@example.com
QUOTEX_PASSWORD=your_password

# ─── Account Mode ──────────────────────────────────────────────────────
# PRACTICE = Demo account (recommended for testing)
# REAL = Real money account (USE WITH CAUTION)
ACCOUNT_MODE=PRACTICE

# ─── Quotex Server ─────────────────────────────────────────────────────
# The broker domain to connect to
# Common options: market-qx.trade, qxbroker.com, quotex.io
QUOTEX_HOST=market-qx.trade
QUOTEX_LANG=en

# ─── Flask Dashboard ───────────────────────────────────────────────────
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# ─── Proxy (Optional) ─────────────────────────────────────────────────
# Leave empty if not using a proxy
PROXY_HTTP=
PROXY_HTTPS=

# ─── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
